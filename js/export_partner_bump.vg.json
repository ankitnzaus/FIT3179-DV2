{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 410,

  "title": {
    "text": "The United States is rising, while China remains number one",
    "subtitle": "Rank among selected major AFF export destinations, 2021–22 to 2024–25",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#183f2c",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",
    "offset": 50
  },

  "data": {
    "url": "data/aff_partner_rank_2021_25.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 85
        }
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "sort": [
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ],
          "axis": {
            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelFontWeight": 500,
            "labelColor": "#536158",
            "labelAngle": 0,
            "labelPadding": 10,
            "domain": false,
            "ticks": false,
            "grid": false
          }
        },

        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Export destination rank",
          "scale": {
            "reverse": true,
            "domain": [1, 17]
          },
          "axis": {
            "values": [1, 2, 3, 4, 5, 6, 8, 10, 12, 14, 16],
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#536158",
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titleColor": "#233d2f",
            "grid": true,
            "gridColor": "#ece8df",
            "domain": false,
            "tickColor": "#d7d2c8"
          }
        },

        "color": {
          "field": "destination",
          "type": "nominal",
          "scale": {
            "domain": [
              "China",
              "United States",
              "Japan",
              "South Korea",
              "Indonesia",
              "India"
            ],
            "range": [
              "#244b35",
              "#b26b3f",
              "#6f8f72",
              "#9d8067",
              "#7a6f5a",
              "#c19a58"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "destination"
        },

        "tooltip": [
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "value_aud_million",
            "type": "quantitative",
            "title": "Export value (A$ million)",
            "format": ",.0f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.year === '2024-25'"
        }
      ],

      "mark": {
        "type": "text",
        "dx": 10,
        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "left"
      },

      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ]
        },

        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "reverse": true,
            "domain": [1, 17]
          }
        },

        "text": {
          "field": "destination"
        },

        "color": {
          "field": "destination",
          "type": "nominal",
          "scale": {
            "domain": [
              "China",
              "United States",
              "Japan",
              "South Korea",
              "Indonesia",
              "India"
            ],
            "range": [
              "#244b35",
              "#b26b3f",
              "#6f8f72",
              "#9d8067",
              "#7a6f5a",
              "#c19a58"
            ]
          },
          "legend": null
        }
      }
    }
  ],

  "config": {
    "background": "#ffffff",
    "view": {
      "stroke": null
    }
  }
}