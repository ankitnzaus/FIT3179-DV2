{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 380,

  "padding": {
    "left": 10,
    "top": 10,
    "right": 90,
    "bottom": 10
  },

  "title": {
    "text": "Food prices continued rising, but slower than overall inflation",
    "subtitle": "Annual percentage change, April 2025 to June 2026",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#183f2c",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",
    "offset": 50
  },

  "data": {
    "url": "data/food_inflation_2025_26.csv"
  },

  "transform": [
    {
      "fold": [
        "food_inflation",
        "headline_cpi"
      ],
      "as": [
        "series",
        "value"
      ]
    },
    {
      "calculate": "datum.series === 'food_inflation' ? 'Food & non-alcoholic beverages' : 'All groups CPI'",
      "as": "series_label"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },

      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "title": null,
          "sort": [
            "Apr-25",
            "May-25",
            "Jun-25",
            "Jul-25",
            "Aug-25",
            "Sep-25",
            "Oct-25",
            "Nov-25",
            "Dec-25",
            "Jan-26",
            "Feb-26",
            "Mar-26",
            "Apr-26",
            "May-26",
            "Jun-26"
          ],
          "axis": {
            "labelAngle": -45,
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#536158",
            "domain": false,
            "ticks": false
          }
        },

        "y": {
          "field": "value",
          "type": "quantitative",
          "title": "Annual change (%)",
          "scale": {
            "domain": [0, 5]
          },
          "axis": {
            "grid": true,
            "gridColor": "#ece8df",
            "domain": false,
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#536158",
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titleColor": "#233d2f"
          }
        },

        "color": {
          "field": "series_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Food & non-alcoholic beverages",
              "All groups CPI"
            ],
            "range": [
              "#93643f",
              "#6f8f72"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "series_label"
        },

        "tooltip": [
          {
            "field": "month",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "series_label",
            "type": "nominal",
            "title": "Series"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Annual change (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "stroke": "#ffffff",
        "strokeWidth": 1.1
      },

      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Apr-25",
            "May-25",
            "Jun-25",
            "Jul-25",
            "Aug-25",
            "Sep-25",
            "Oct-25",
            "Nov-25",
            "Dec-25",
            "Jan-26",
            "Feb-26",
            "Mar-26",
            "Apr-26",
            "May-26",
            "Jun-26"
          ]
        },

        "y": {
          "field": "value",
          "type": "quantitative"
        },

        "color": {
          "field": "series_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Food & non-alcoholic beverages",
              "All groups CPI"
            ],
            "range": [
              "#93643f",
              "#6f8f72"
            ]
          },
          "legend": null
        },

        "detail": {
          "field": "series_label"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.month === 'Jun-26'"
        },
        {
          "calculate": "datum.series === 'food_inflation' ? 'Food prices  ' + format(datum.value, '.1f') + '%' : 'All groups CPI  ' + format(datum.value, '.1f') + '%'",
          "as": "end_label"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "font": "Source Sans 3",
        "fontSize": 20,
        "fontWeight": 700
      },

      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "sort": [
            "Apr-25",
            "May-25",
            "Jun-25",
            "Jul-25",
            "Aug-25",
            "Sep-25",
            "Oct-25",
            "Nov-25",
            "Dec-25",
            "Jan-26",
            "Feb-26",
            "Mar-26",
            "Apr-26",
            "May-26",
            "Jun-26"
          ]
        },

        "y": {
          "field": "value",
          "type": "quantitative"
        },

        "text": {
          "field": "end_label"
        },

        "color": {
          "field": "series_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Food & non-alcoholic beverages",
              "All groups CPI"
            ],
            "range": [
              "#93643f",
              "#6f8f72"
            ]
          },
          "legend": null
        }
      }
    }
  ],

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    }
  }
}