{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 390,

  "padding": {
    "left": 70,
    "top": 8,
    "right": 25,
    "bottom": 8
  },

  "title": {
    "text": "Food is wasted at every stage — but households contribute the most",
    "subtitle": "Estimated Australian food waste by supply-chain stage, 2021",
    "anchor": "start",

    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#183f2c",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",

    "offset": 50
  },

  "data": {
    "url": "data/food_waste_sector_2021.csv",
    "format": {
      "type": "csv",
      "parse": {
        "waste_million_tonnes": "number"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
      },

      "encoding": {
        "y": {
          "field": "sector",
          "type": "nominal",
          "sort": "-x",
          "title": null,

          "axis": {
            "labelFont": "Source Sans 3",
            "labelFontSize": 13,
            "labelFontWeight": 500,
            "labelColor": "#24352d",
            "labelPadding": 10,
            "labelLimit": 220,

            "domain": false,
            "ticks": false
          }
        },

        "x": {
          "field": "waste_million_tonnes",
          "type": "quantitative",

          "title": "Food waste (million tonnes)",

          "scale": {
            "domain": [0, 2.7]
          },

          "axis": {
            "values": [
              0,
              0.5,
              1.0,
              1.5,
              2.0,
              2.5
            ],

            "format": ".1f",

            "grid": true,
            "gridColor": "#ece8df",
            "gridOpacity": 1,

            "domain": false,
            "ticks": false,

            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#536158",

            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 600,
            "titleColor": "#233d2f"
          }
        },

        "color": {
          "condition": {
            "test": "datum.sector === 'Households'",
            "value": "#93643f"
          },

          "value": "#9bb19a"
        },

        "tooltip": [
          {
            "field": "sector",
            "type": "nominal",
            "title": "Stage"
          },
          {
            "field": "waste_million_tonnes",
            "type": "quantitative",
            "title": "Food waste (million tonnes)",
            "format": ".3f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,

        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700,

        "color": "#24352d"
      },

      "encoding": {
        "y": {
          "field": "sector",
          "type": "nominal",
          "sort": "-x"
        },

        "x": {
          "field": "waste_million_tonnes",
          "type": "quantitative"
        },

        "text": {
          "field": "waste_million_tonnes",
          "type": "quantitative",
          "format": ".2f"
        }
      }
    }
  ],

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    }
  }
}