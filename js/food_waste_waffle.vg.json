{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 620,
  "height": 340,

  "title": {
    "text": "Around three in every ten tonnes of food waste comes from households",
    "subtitle": "Approximate household share of Australia's annual food waste",
    "anchor": "start",

    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#183f2c",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",

    "offset": 50
  },

  "data": {
    "sequence": {
      "start": 1,
      "stop": 101,
      "as": "square"
    }
  },

  "transform": [
    {
      "calculate": "(datum.square - 1) % 10",
      "as": "column"
    },
    {
      "calculate": "floor((datum.square - 1) / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.square <= 30 ? 'Household waste' : 'Other stages'",
      "as": "group"
    }
  ],

  "mark": {
    "type": "square",
    "size": 820,
    "cornerRadius": 3
  },

  "encoding": {
    "x": {
      "field": "column",
      "type": "ordinal",
      "axis": null
    },

    "y": {
      "field": "row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null
    },

    "color": {
      "field": "group",
      "type": "nominal",

      "scale": {
        "domain": [
          "Household waste",
          "Other stages"
        ],
        "range": [
          "#b08a68",
          "#e8e9e3"
        ]
      },

      "legend": {
        "title": null,
        "orient": "bottom",
        "direction": "horizontal",
        "columns": 2,

        "symbolType": "square",
        "symbolSize": 130,

        "labelFont": "Source Sans 3",
        "labelFontSize": 12,
        "labelColor": "#43544a",
        "labelLimit": 200,

        "columnPadding": 28,
        "offset": 14
      }
    },

    "tooltip": [
      {
        "field": "group",
        "type": "nominal",
        "title": null
      }
    ]
  },

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    }
  }
}