{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 520,

  "title": {
    "text": "Where did food horticulture value change the most?",
    "subtitle": "Percentage change in food horticulture farm-gate value, 2023–24 to 2024–25",
    "anchor": "start",
    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#183f2c",
    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",
    "offset": 14
  },

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#e8ece5",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },

    {
      "data": {
        "url": "data/horticulture_state_2024_25.csv"
      },

      "transform": [
        {
          "filter": "datum.state !== 'Australian Capital Territory'"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/australia_states.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.STATE_NAME"
          },
          "as": "geo"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.4
      },

      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },

        "color": {
          "field": "pct_change",
          "type": "quantitative",

          "scale": {
            "domain": [-3, 0, 12],
            "range": [
              "#b95a4a",
              "#f2ead8",
              "#2f7d4c"
            ]
          },

          "legend": {
            "title": "% change",
            "orient": "right",
            "gradientLength": 200,
            "gradientThickness": 13,
            "titleFont": "Source Sans 3",
            "titleFontSize": 12,
            "titleFontWeight": 700,
            "labelFont": "Source Sans 3",
            "labelFontSize": 11,
            "labelColor": "#58655e"
          }
        },

        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "horticulture_value_2023_24",
            "type": "quantitative",
            "title": "2023–24 value (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "horticulture_value_2024_25",
            "type": "quantitative",
            "title": "2024–25 value (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "pct_change",
            "type": "quantitative",
            "title": "Change (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    }
  }
}