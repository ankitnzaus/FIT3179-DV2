{
  "$schema": "https://vega.github.io/schema/vega/v5.json",

  "width": 940,
  "height": 360,

  "padding": {
    "top": 8,
    "left": 0,
    "right": 0,
    "bottom": 0
  },

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "background": "#ffffff",

  "title": {
    "text": "Fruit and vegetables dominate Australia's food horticulture",
    "subtitle": "Farm-gate value by horticulture category, 2024–25",
    "anchor": "start",

    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "fill": "#183f2c",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",

    "offset": 14
  },

  "data": [
    {
      "name": "tree",

      "url": "data/horticulture_australia_2024_25.csv",

      "format": {
        "type": "csv",
        "parse": {
          "value_m": "number"
        }
      },

      "transform": [
        {
          "type": "stratify",
          "key": "category",
          "parentKey": "parent"
        },

        {
          "type": "treemap",
          "field": "value_m",

          "sort": {
            "field": "value_m",
            "order": "descending"
          },

          "round": true,
          "method": "squarify",
          "ratio": 1.6,

          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },

    {
      "name": "leaves",

      "source": "tree",

      "transform": [
        {
          "type": "filter",
          "expr": "datum.category != 'Australia'"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "color",

      "type": "ordinal",

      "domain": [
        "Fruit",
        "Vegetables",
        "Nuts",
        "Wine grapes"
      ],

      "range": [
        "#376f4b",
        "#6f9c68",
        "#a3bd8e",
        "#c9d5aa"
      ]
    }
  ],

  "marks": [
    {
      "type": "rect",

      "from": {
        "data": "leaves"
      },

      "encode": {
        "enter": {
          "fill": {
            "scale": "color",
            "field": "category"
          },

          "stroke": {
            "value": "#ffffff"
          },

          "strokeWidth": {
            "value": 2
          }
        },

        "update": {
          "x": {
            "field": "x0"
          },

          "y": {
            "field": "y0"
          },

          "x2": {
            "field": "x1"
          },

          "y2": {
            "field": "y1"
          },

          "tooltip": {
            "signal": "{'Category': datum.category, 'Farm-gate value (A$ million)': format(datum.value_m, ',.1f')}"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "leaves"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },

          "y": {
            "signal": "(datum.y0 + datum.y1) / 2 - 11"
          },

          "align": {
            "value": "center"
          },

          "baseline": {
            "value": "middle"
          },

          "fill": {
            "value": "#ffffff"
          },

          "font": {
            "value": "Manrope"
          },

          "fontWeight": {
            "value": 700
          },

          "fontSize": {
            "signal": "datum.value_m > 3000 ? 18 : 14"
          },

          "text": {
            "field": "category"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "leaves"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "(datum.x0 + datum.x1) / 2"
          },

          "y": {
            "signal": "(datum.y0 + datum.y1) / 2 + 15"
          },

          "align": {
            "value": "center"
          },

          "baseline": {
            "value": "middle"
          },

          "fill": {
            "value": "#ffffff"
          },

          "font": {
            "value": "Source Sans 3"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": 600
          },

          "text": {
            "signal": "'A$' + format(datum.value_m / 1000, '.2f') + 'B'"
          }
        }
      }
    }
  ]
}