{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": {
    "step": 46
  },

  "padding": {
    "left": 10,
    "top": 8,
    "right": 50,
    "bottom": 10
  },

  "title": {
    "text": "Food inflation was no higher than headline inflation in any capital city",
    "subtitle": "Annual percentage change, June 2026",
    "anchor": "start",

    "font": "Manrope",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#183f2c",

    "subtitleFont": "Source Sans 3",
    "subtitleFontSize": 13,
    "subtitleFontWeight": 400,
    "subtitleColor": "#68746d",

    "offset": 50
  },

  "data": {
    "url": "data/food_inflation_capital_cities_jun2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "food_cpi": "number",
        "all_groups_cpi": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "datum.all_groups_cpi - datum.food_cpi",
      "as": "gap"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#c8c2b7",
        "strokeWidth": 3
      },

      "encoding": {
        "y": {
          "field": "city",
          "type": "nominal",

          "sort": [
            "Hobart",
            "Adelaide",
            "Sydney",
            "Brisbane",
            "Darwin",
            "Canberra",
            "Perth",
            "Melbourne"
          ],

          "axis": {
            "title": null,
            "labelFont": "Source Sans 3",
            "labelFontSize": 14,
            "labelFontWeight": 500,
            "labelColor": "#233d2f",
            "labelPadding": 12,
            "ticks": false,
            "domain": false
          }
        },

        "x": {
          "field": "food_cpi",
          "type": "quantitative",
          "scale": {
            "domain": [2.5, 4.5],
            "zero": false
          }
        },

        "x2": {
          "field": "all_groups_cpi"
        },

        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "food_cpi",
            "type": "quantitative",
            "title": "Food prices",
            "format": ".1f"
          },
          {
            "field": "all_groups_cpi",
            "type": "quantitative",
            "title": "All groups CPI",
            "format": ".1f"
          },
          {
            "field": "gap",
            "type": "quantitative",
            "title": "Difference",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "fold": [
            "food_cpi",
            "all_groups_cpi"
          ],
          "as": [
            "series",
            "value"
          ]
        },

        {
          "calculate": "datum.series === 'food_cpi' ? 'Food prices' : 'All groups CPI'",
          "as": "series_label"
        }
      ],

      "mark": {
        "type": "point",
        "filled": true,
        "size": 125,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },

      "encoding": {
        "y": {
          "field": "city",
          "type": "nominal",

          "sort": [
            "Hobart",
            "Adelaide",
            "Sydney",
            "Brisbane",
            "Darwin",
            "Canberra",
            "Perth",
            "Melbourne"
          ]
        },

        "x": {
          "field": "value",
          "type": "quantitative",

          "scale": {
            "domain": [2.5, 4.5],
            "zero": false
          },

          "axis": {
            "title": "Annual change (%)",

            "titleFont": "Source Sans 3",
            "titleFontSize": 13,
            "titleFontWeight": 600,
            "titleColor": "#233d2f",

            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelColor": "#536158",

            "grid": true,
            "gridColor": "#ddd8ce",
            "gridOpacity": 1,

            "tickColor": "#b7b1a4",
            "domain": false,

            "values": [
              2.5,
              3.0,
              3.5,
              4.0,
              4.5
            ]
          }
        },

        "color": {
          "field": "series_label",
          "type": "nominal",

          "scale": {
            "domain": [
              "Food prices",
              "All groups CPI"
            ],

            "range": [
              "#93643f",
              "#6f8f71"
            ]
          },

          "legend": {
            "title": null,
            "orient": "top",
            "direction": "horizontal",

            "symbolType": "circle",
            "symbolSize": 90,

            "labelFont": "Source Sans 3",
            "labelFontSize": 12,
            "labelFontWeight": 600,
            "labelColor": "#233d2f",

            "offset": 12
          }
        },

        "tooltip": [
          {
            "field": "city",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "series_label",
            "type": "nominal",
            "title": "Series"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Annual change (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "filter": "datum.city === 'Adelaide'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -9,

        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700,

        "color": "#93643f"
      },

      "encoding": {
        "y": {
          "field": "city",
          "type": "nominal",

          "sort": [
            "Hobart",
            "Adelaide",
            "Sydney",
            "Brisbane",
            "Darwin",
            "Canberra",
            "Perth",
            "Melbourne"
          ]
        },

        "x": {
          "field": "food_cpi",
          "type": "quantitative",
          "scale": {
            "domain": [2.5, 4.5],
            "zero": false
          }
        },

        "text": {
          "signal": "format(datum.food_cpi, '.1f') + '%'"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.city === 'Adelaide'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,

        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700,

        "color": "#6f8f71"
      },

      "encoding": {
        "y": {
          "field": "city",
          "type": "nominal",

          "sort": [
            "Hobart",
            "Adelaide",
            "Sydney",
            "Brisbane",
            "Darwin",
            "Canberra",
            "Perth",
            "Melbourne"
          ]
        },

        "x": {
          "field": "all_groups_cpi",
          "type": "quantitative",
          "scale": {
            "domain": [2.5, 4.5],
            "zero": false
          }
        },

        "text": {
          "signal": "format(datum.all_groups_cpi, '.1f') + '%'"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.city === 'Melbourne'"
        }
      ],

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 12,

        "font": "Source Sans 3",
        "fontSize": 12,
        "fontWeight": 700,

        "color": "#536158"
      },

      "encoding": {
        "y": {
          "field": "city",
          "type": "nominal",

          "sort": [
            "Hobart",
            "Adelaide",
            "Sydney",
            "Brisbane",
            "Darwin",
            "Canberra",
            "Perth",
            "Melbourne"
          ]
        },

        "x": {
          "field": "all_groups_cpi",
          "type": "quantitative",
          "scale": {
            "domain": [2.5, 4.5],
            "zero": false
          }
        },

        "text": {
          "signal": "format(datum.all_groups_cpi, '.1f') + '% both'"
        }
      }
    }
  ],

  "config": {
    "background": "#ffffff",

    "view": {
      "stroke": null
    }
  }
}