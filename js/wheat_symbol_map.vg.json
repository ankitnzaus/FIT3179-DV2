{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 500,
  "title": {
    "text": "Australia's wheat production is concentrated in a few states",
    "subtitle": "Wheat production sold by state, 2024–25",
    "fontSize": 20,
    "subtitleFontSize": 13,
    "anchor": "start"
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "projection": {
        "type": "mercator"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8eee5",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/wheat_state_2024_25.csv"
      },
      "projection": {
        "type": "mercator"
      },
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "wheat_000_tonnes",
          "type": "quantitative",
          "title": "Wheat production ('000 tonnes)",
          "scale": {
            "range": [40, 2500]
          }
        },
        "color": {
          "value": "#b47b32"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "wheat_000_tonnes",
            "type": "quantitative",
            "title": "Production ('000 tonnes)",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}